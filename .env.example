# SQLAlchemy async database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/bilianalyzer.db

# Key used to encrypt stored credentials (SESSDATA, AI API key, proxy list).
# Leave empty to auto-generate and persist one at DATA_DIR/.secret_key.
# Changing this after credentials are stored makes them undecryptable.
SECRET_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Must NOT be "*" together with credentialed requests (see backend/app/main.py).
CORS_ORIGINS=http://localhost:5173

# Directory for the SQLite DB file and the auto-generated secret key.
DATA_DIR=./data

# How often the background worker captures creator-level followers, account
# views and account likes. Video snapshots use an age-based cadence. Set to 0
# to disable all automatic snapshots; manual refreshes remain available.
STATS_REFRESH_HOURS=24

# How often the site-wide chart is polled for intraday rank changes. Set to 0
# to disable automatic chart polling while retaining other background work.
RANKING_REFRESH_MINUTES=15

# How often each tracked creator's latest uploads are checked for unseen video
# IDs. Set to 0 to disable automatic discovery of new uploads.
NEW_VIDEO_REFRESH_MINUTES=30
