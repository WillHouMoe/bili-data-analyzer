# SQLAlchemy async database URL.
DATABASE_URL=sqlite+aiosqlite:///./data/bilianalyzer.db

# Key used to encrypt stored credentials (SESSDATA, AI API key, proxy list).
# Leave empty to auto-generate and persist one at DATA_DIR/.secret_key.
# Changing this after credentials are stored makes them undecryptable.
SECRET_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Must NOT be "*" together with credentialed requests (see backend/app/main.py).
CORS_ORIGINS=http://localhost:5173

# Directory for the SQLite DB file and the auto-generated secret key.
DATA_DIR=./data

# How often the background worker captures a fresh stats snapshot for each
# creator. Set to 0 to disable automatic snapshots; the dashboard still has a
# manual "Capture snapshot" action.
STATS_REFRESH_HOURS=24
